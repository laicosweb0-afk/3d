{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // club-rama/ e club-aurea/ sono progetti Vite a se': hanno il loro
    // tsconfig, le loro dipendenze e un altro jsx. Lasciarli dentro a questo
    // include li fa controllare col compilatore sbagliato e la build di Next
    // fallisce.
    "club-rama",
    "club-aurea"
  ]
}
