# Copia questo file in .env.local (che resta fuori da git) e riempi i valori.
# In produzione le stesse variabili si mettono su Vercel: Settings → Environment
# Variables. Le chiavi NON vanno mai committate.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave di servizio: scavalca le regole di riga (RLS). Solo lato server,
# usata esclusivamente da /api/lead. Mai esporla al browser.
SUPABASE_SERVICE_ROLE_KEY=

# Pepe per l'hash degli IP nel freno anti-abuso: una stringa casuale lunga.
# Cambiandola si azzerano i conteggi. L'IP in chiaro non viene mai salvato.
LEAD_IP_PEPE=

# Chi può chiamare /api/lead dal browser (separati da virgola).
ORIGINI_CONSENTITE=https://club.ramastore.it

# Resend (invio del codice via email). Senza questa chiave il CRM registra il
# lead lo stesso e la card dice al cliente di mostrare il codice in negozio.
RESEND_API_KEY=
EMAIL_MITTENTE=Rama Ceramiche <club@ramastore.it>
EMAIL_RISPOSTA=info@ramastore.it

# ---------------------------------------------------------------------------
# Aggiunte con la fase operativa. Tutte facoltative: senza, la funzione
# corrispondente si spegne e lo dice — non finge di funzionare.
# I passaggi per riempirle stanno in SETUP_GUIDE.md.
# ---------------------------------------------------------------------------

# Forza i dati di esempio anche con Supabase configurato. Comodo per far
# vedere il CRM senza toccare niente di vero.
# CRM_MODO=demo

# Dove manda la card NFC quando non le è stata data una destinazione sua.
# Serve se il CRM e il sito stanno su due indirizzi diversi: senza, la card
# porta a una pagina del Club che dentro il CRM non esiste.
SITO_URL=https://ramastore.it

# Firma le porte pubbliche: /api/ingresso/[canale] e /api/webhooks/forms.
# Generala con: openssl rand -hex 32
# Senza, in produzione quelle rotte rispondono 503.
INGRESSO_SEGRETO=

# ---- Meta: Messenger, Instagram, WhatsApp, Lead Ads -----------------------
# Lo inventi tu: serve solo alla stretta di mano quando Meta si iscrive al
# webhook. Va scritto identico qui e nel pannello Meta.
META_VERIFY_TOKEN=

# App Settings → Basic → App Secret. Serve a verificare che una richiesta
# arrivi davvero da Meta: senza, chiunque potrebbe riempire il CRM di finti
# clienti.
META_APP_SECRET=

# Accende la traduzione dei payload. Si mette solo dopo che l'app Meta è
# approvata: meglio muto che sbagliato.
# META_ADATTATORI=attivo

# Token della Pagina con il permesso leads_retrieval. Serve ai Lead Ads:
# Meta manda solo un identificativo, i dati si vanno a prendere. Senza
# questo token il CRM non crea nessun contatto dai Lead Ads — conserva
# l'avviso e lo segna «in attesa». I lead restano su Meta 90 giorni.
META_PAGE_TOKEN=
