# Copia questo file in `.env.local` per lo sviluppo, e incolla gli stessi valori
# nelle Environment Variables di Vercel per la produzione.
# NESSUNA di queste variabili ha il prefisso NEXT_PUBLIC_: restano tutte sul
# server, non finiscono mai nel bundle del browser.

# --- Accesso alla demo ---------------------------------------------------
# La parola da dare al titolare insieme al link. Sceglila tu.
DEMO_PASSWORD=

# --- Il cervello del Bianconiglio ---------------------------------------
ANTHROPIC_API_KEY=
# Facoltativo: per cambiare modello senza toccare il codice.
# Default se non impostato: claude-sonnet-5
ANTHROPIC_MODEL=

# --- La voce -------------------------------------------------------------
# Finché queste due restano vuote la demo funziona lo stesso: ripiega sulla
# voce del browser con il tono acuto. Appena le compili, parte la voce vera.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Facoltativo. Default: eleven_turbo_v2_5 (il più veloce che parla italiano).
# Per una resa più curata a scapito di ~1s di attesa: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=
